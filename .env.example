# Copy to .env for local use. Do not commit real values.

# Optional Feishu notification webhook. Leave empty to disable notifications.
FEISHU_WEBHOOK_URL=

# Optional ACP runtime overrides.
ACP_CLIENT_CMD="hermes acp"
ACP_CWD="."
ACP_TIMEOUT_S=1800

# Usually set by scripts; only override when debugging manually.
ACP_PROMPT_FILE=
ACP_STDOUT_LOG=

# Optional custom guard rules file.
GUARD_RULES_PATH="luban-skills/references/allowlist-default.yaml"
